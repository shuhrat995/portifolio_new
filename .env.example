# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored — never commit real secrets.
# ---------------------------------------------------------------------------

# The password for the admin panel at /qw
ADMIN_PASSWORD=change-me-please

# Optional. Changing this invalidates every existing login session.
# If unset, ADMIN_PASSWORD is used as the signing key.
ADMIN_SECRET=

# ---------------------------------------------------------------------------
# Optional: persist admin edits by committing to GitHub.
# Requires a fine-grained Personal Access Token with "Contents: Read and write"
# on the repository below. Without these, edits are written to data/*.json on
# the local disk (works when running `npm run dev` / `npm start`, but not on
# serverless hosts, where the filesystem is read-only).
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_DATA_REPO=shuhrat995/portfolio
GITHUB_DATA_BRANCH=main
GITHUB_DATA_PATH=data

# Optional: used by `npm run sync` for a higher GitHub API rate limit.
# Without it the script scrapes public HTML instead.
# GITHUB_TOKEN doubles as this if you set it above.
